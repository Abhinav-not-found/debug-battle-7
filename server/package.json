{
  "name": "ecommerce-backend-ts",
  "version": "1.0.0",
  "description": "E-commerce backend (TypeScript) following Controller -> Service -> Repository -> Contract architecture",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node init && ts-node-dev --respawn --transpile-only server.ts",
    "build": "node init && tsc -p tsconfig.json",
    "start": "node init && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "generate:client": "npm run generate:openapi && openapi --input generated/openapi.json --output ../client/src/api --client axios"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.19.43",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "openapi-typescript-codegen": "^0.31.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.3"
  }
}
